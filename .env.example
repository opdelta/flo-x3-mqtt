# Copy to .env and fill in locally. Only this template belongs in Git.
# FLO credentials
FLO_USERNAME=
FLO_PASSWORD=
# Charger nickname, physical reference/serial, or station ID.
FLO_STATION_NAME=your_charger_name_or_serial
FLO_LOG_LEVEL=INFO

# MQTT Configuration
HASS_MQTT_HOST=mqtt.example.com
HASS_MQTT_PORT=1883
# Optional if the broker does not require authentication.
HASS_MQTT_USERNAME=
HASS_MQTT_PASSWORD=
